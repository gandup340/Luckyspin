# Copy to .env and adjust for your host.
# Never commit a real .env file.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Required in production for first-time admin bootstrap / password rotation
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Optional: force username + sync password on boot when ADMIN_SYNC=1
# ADMIN_USERNAME=admin
ADMIN_SYNC=1
# One-shot: invalidate all support passwords and set admin from ADMIN_PASSWORD
# FORCE_ROTATE_PASSWORDS=1

# Session / chat signing secrets (use long random strings in production)
# SESSION_SECRET=
# CHAT_SESSION_SECRET=

# Optional: where JSON data is stored (absolute path recommended on VPS)
# DATA_DIR=/var/lib/slot-valley/data

# Set to 0 only if you are NOT behind a reverse proxy
TRUST_PROXY=1

# Comma-separated browser origins allowed for WebSocket
ALLOWED_ORIGINS=https://luckyspinns.com,https://www.luckyspinns.com

# WebRTC TURN (Metered.ca)
# Preferred: fetch fresh credentials from Metered API (auto-rotates).
METERED_TURN_API_KEY=your-metered-api-key
METERED_TURN_DOMAIN=luckyspinns.metered.live
# Optional static fallback if the API is unreachable:
# TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential

# Facebook Messenger (keep secrets only in .env / Render env — never commit real values)
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_VERIFY_TOKEN=luckyvipspins2026
# FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v21.0

# Chat / session signing (optional — server derives a fallback if unset)
# SESSION_SECRET=
# CHAT_SESSION_SECRET=

# Web Push — set all three on Render (Environment)
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@luckyspinns.com

# Neon Postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# DATABASE_SSL_CA=/path/to/neon-ca.pem
# DATABASE_SSL_REJECT_UNAUTHORIZED=0

# Email verification / password reset via SMTP (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=0
EMAIL_FROM=Slot Valley <noreply@yourdomain.com>
# SMTP_TLS_REJECT_UNAUTHORIZED=0

# Juwa / game agent automation (server-side only)
JUWA_AUTOMATION_ENABLED=1
JUWA_AUTO_PROCESS=1
JUWA_LOGIN_URL=https://ht.juwa777.com/login
JUWA_USER_MGMT_URL=https://ht.juwa777.com/userManagement
JUWA_AGENT_USERNAME=
JUWA_AGENT_PASSWORD=
JUWA_HEADED=0
JUWA_PYTHON_BRIDGE=1
JUWA_PYTHON_BIN=python

JUWA2_AUTOMATION_ENABLED=1
JUWA2_AUTO_PROCESS=1
JUWA2_LOGIN_URL=https://agent.juwa2.com/login
JUWA2_USER_MGMT_URL=https://agent.juwa2.com/userManagement
JUWA2_AGENT_USERNAME=
JUWA2_AGENT_PASSWORD=

MILKYWAY_AUTOMATION_ENABLED=1
MILKYWAY_LOGIN_URL=https://milkywayapp.xyz:8781/default.aspx?639225872727471705
MILKYWAY_STORE_URL=https://milkywayapp.xyz:8781/Store.aspx
MILKYWAY_AGENT_USERNAME=
MILKYWAY_AGENT_PASSWORD=

GAMEVAULT_AUTOMATION_ENABLED=1
GAMEVAULT_AUTO_PROCESS=1
GAMEVAULT_LOGIN_URL=https://agent.gamevault999.com/login
GAMEVAULT_USER_MGMT_URL=https://agent.gamevault999.com/userManagement
GAMEVAULT_AGENT_USERNAME=
GAMEVAULT_AGENT_PASSWORD=

ORION_AUTOMATION_ENABLED=1
ORION_AUTO_PROCESS=1
ORION_LOGIN_URL=https://orionstars.vip:8781/default.aspx
ORION_STORE_URL=https://orionstars.vip:8781/Store.aspx
ORION_AGENT_USERNAME=
