# Copy to .env and adjust for your host.
# Never commit a real .env file.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Required in production for first-time admin bootstrap
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Optional: force username + sync password on boot when ADMIN_SYNC=1
# ADMIN_USERNAME=admin
# ADMIN_SYNC=0

# Optional: where JSON data is stored (absolute path recommended on VPS)
# DATA_DIR=/var/lib/lucky-vips-game/data

# Set to 0 only if you are NOT behind a reverse proxy
TRUST_PROXY=1

# Comma-separated browser origins allowed for WebSocket (recommended in production)
# Example: https://your-app.onrender.com,https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://luckyspin-yetv.onrender.com

# Facebook Messenger (keep secrets only in .env / Render env — never commit real values)
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_VERIFY_TOKEN=luckyvipspins2026
# FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v21.0

# Web Push (generate with: npx web-push generate-vapid-keys)
# Keep VAPID_PRIVATE_KEY secret — never expose it in frontend code.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# Neon Postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Email verification / password reset via SMTP (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=0
EMAIL_FROM=LUCKY VIPS GAME <noreply@yourdomain.com>
# SMTP_TLS_REJECT_UNAUTHORIZED=0

# Juwa agent automation (server-side only — never put these in frontend code)
JUWA_AUTOMATION_ENABLED=1
JUWA_AUTO_PROCESS=1
JUWA_LOGIN_URL=https://ht.juwa777.com/login
JUWA_USER_MGMT_URL=https://ht.juwa777.com/userManagement
JUWA_AGENT_USERNAME=
JUWA_AGENT_PASSWORD=
JUWA_HEADED=0
JUWA_PYTHON_BRIDGE=1
JUWA_PYTHON_BIN=python
# JUWA_PYTHON_SCRIPT=
# Flow: player chats "add 20" → bot asks username → which game (juwa, milkyway, or gamevault) → recharge → "added 20 to USER on Game"
# Or: add 20 to gamevault theiruser

MILKYWAY_AUTOMATION_ENABLED=1
MILKYWAY_LOGIN_URL=https://milkywayapp.xyz:8781/default.aspx?639225872727471705
MILKYWAY_STORE_URL=https://milkywayapp.xyz:8781/Store.aspx
MILKYWAY_AGENT_USERNAME=
MILKYWAY_AGENT_PASSWORD=

GAMEVAULT_AUTOMATION_ENABLED=1
GAMEVAULT_AUTO_PROCESS=1
GAMEVAULT_LOGIN_URL=https://agent.gamevault999.com/login
GAMEVAULT_USER_MGMT_URL=https://agent.gamevault999.com/userManagement
GAMEVAULT_AGENT_USERNAME=
GAMEVAULT_AGENT_PASSWORD=
