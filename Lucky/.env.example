# Copy to .env and adjust for your host.
# Never commit a real .env file.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Required in production for first-time admin bootstrap
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Optional: where JSON data is stored (absolute path recommended on VPS)
# DATA_DIR=/var/lib/lucky-vips-game/data

# Set to 0 only if you are NOT behind a reverse proxy
TRUST_PROXY=1

# Comma-separated browser origins allowed for WebSocket (recommended in production)
# Example: https://yourdomain.com,https://www.yourdomain.com
# ALLOWED_ORIGINS=https://yourdomain.com

# Facebook Messenger (keep secrets only in .env — never commit real values)
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_VERIFY_TOKEN=
# FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v21.0
